rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // token.get() rather than token.email: anonymous identities (the door
    // devices) carry no email claim at all, and this is the first thing
    // evaluated on most of the rules below.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('email', '') == 'hsallah@outlook.sa';
    }

    function isOwner(eventId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid;
    }

    // Where the door code lives. It used to be a plain field on the event doc
    // — which has to stay world-readable, since invite.html and scan.html
    // show the event's name/date without a sign-in — so anyone holding an
    // invite link could read the door code straight out of the database.
    // It now lives in events/{id}/private/scan, readable only by the owner
    // and the admin. Older events still carry it on the event doc until the
    // owner next opens the dashboard (event.html moves it over); this falls
    // back to that field so those events keep working meanwhile.
    function currentScanPin(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)/private/scan)
        ? get(/databases/$(database)/documents/events/$(eventId)/private/scan).data.scanPin
        : get(/databases/$(database)/documents/events/$(eventId)).data.scanPin;
    }

    // How a door device (scan.html — no account, anonymous sign-in only)
    // proves it knows the code: it creates its own session doc, keyed by its
    // anonymous uid, containing the code it was given. The create rule below
    // does the comparison, so the real code never reaches the device — all
    // it learns is accepted/denied. A session only stays valid while the
    // code stored in it is still the live one, which is what makes
    // "generate a new code" on the dashboard revoke every device at once.
    function hasScanSession(eventId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/events/$(eventId)/scanSessions/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/events/$(eventId)/scanSessions/$(request.auth.uid)).data.pin == currentScanPin(eventId);
    }

    // Free tier + payment gate: an event's owner can add up to
    // FREE_GUEST_LIMIT guests for free; beyond that (or to share the invite
    // unlimited) the admin must flip `paid` to true (after an off-platform
    // bank transfer). getAfter (not get) on guestCount so the check sees the
    // post-transaction count — the client must bump it in the same
    // transaction as the guest write, it can't just be read as a stale
    // value. Keep the 5 in sync with FREE_GUEST_LIMIT in utils.js.
    function eventCanAcceptGuest(eventId, uid) {
      let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
      let evAfter = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      return ev.ownerUid == uid && (ev.paid == true || evAfter.guestCount <= 5);
    }

    // Lets the owner's guestCount update go through even for events created
    // before this field existed (no old value to compare against yet).
    function guestCountNotDecreased() {
      return !('guestCount' in resource.data) ||
        request.resource.data.guestCount >= resource.data.guestCount;
    }

    match /eventRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'status', 'requestedAt']) &&
        request.resource.data.status == 'pending';
      allow read: if request.auth != null && (isAdmin() || resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    // Tracks how many events each customer currently owns (eventCount) against
    // how many they're allowed (eventLimit). A customer can bump their own
    // eventCount by exactly ±1 (on event create/delete), and can self-serve
    // raise their own eventLimit by 1 at a time up to AUTO_APPROVE_CEILING —
    // beyond that only the admin can raise it further (via approve-request).
    match /accountLimits/{uid} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == uid);

      // A customer's very first event bootstraps this doc. The admin can
      // also create one for a customer (approving an extra-event request
      // for someone who has no doc yet writes eventLimit 2 / eventCount 0,
      // which the customer-only branch below would reject).
      allow create: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.eventLimit == 1 && request.resource.data.eventCount == 1)
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventCount']) &&
          request.resource.data.eventLimit == resource.data.eventLimit &&
          (
            (request.resource.data.eventCount == resource.data.eventCount + 1 &&
             resource.data.eventCount < resource.data.eventLimit) ||
            (request.resource.data.eventCount == resource.data.eventCount - 1 &&
             resource.data.eventCount > 0)
          )
        ) ||
        (
          // self-service limit bump, capped at 3 — keep in sync with
          // AUTO_APPROVE_CEILING in app.html
          request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventLimit']) &&
          request.resource.data.eventCount == resource.data.eventCount &&
          request.resource.data.eventLimit == resource.data.eventLimit + 1 &&
          request.resource.data.eventLimit <= 3
        )
      );
    }

    match /events/{eventId} {
      // Public on purpose: invite.html (guests) and scan.html (door staff)
      // need the name/date/venue/theme without signing in. Nothing secret
      // may live on this doc — see currentScanPin() above.
      allow get: if true;
      allow list: if request.auth != null &&
        (isAdmin() || resource.data.ownerUid == request.auth.uid);

      // The real one-event-per-customer enforcement: a non-admin create must
      // land alongside a valid accountLimits write (checked via getAfter, so
      // both documents are validated as part of the same atomic transaction)
      // whose resulting eventCount doesn't exceed eventLimit.
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid &&
        (
          isAdmin() ||
          (
            existsAfter(/databases/$(database)/documents/accountLimits/$(request.auth.uid)) &&
            getAfter(/databases/$(database)/documents/accountLimits/$(request.auth.uid)).data.eventCount <=
            getAfter(/databases/$(database)/documents/accountLimits/$(request.auth.uid)).data.eventLimit
          )
        );

      // The owner can freely edit their event (name/date/venue/theme/etc.)
      // but cannot touch `paid` or `ownerUid` themselves — only the admin
      // can activate payment or reassign ownership.
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.paid == resource.data.paid &&
          guestCountNotDecreased()
        )
      );
      allow delete: if request.auth != null &&
        (isAdmin() || resource.data.ownerUid == request.auth.uid);

      // Owner/admin-only secrets for this event (the door code).
      match /private/{docId} {
        allow read, write: if isAdmin() || isOwner(eventId);
      }

      // One doc per door device that has proven it knows the code. Only the
      // device's own anonymous identity can create its doc, and only with
      // the correct code (the comparison happens here, server-side).
      match /scanSessions/{sessionId} {
        allow create, update: if request.auth != null && sessionId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['pin', 'createdAt']) &&
          request.resource.data.pin is string &&
          request.resource.data.pin == currentScanPin(eventId);
        // Reading your own session back succeeds only while it's still valid
        // — after the owner changes the code, this read is denied, which is
        // how a device learns it needs the new code.
        allow get: if request.auth != null && sessionId == request.auth.uid && hasScanSession(eventId);
        allow list: if isAdmin() || isOwner(eventId);
        allow delete: if request.auth != null &&
          (sessionId == request.auth.uid || isAdmin() || isOwner(eventId));
      }

      match /guests/{guestId} {
        // Names and barcode ids used to be world-readable. Now: the owner,
        // the admin, or a door device holding a valid session.
        allow read: if isAdmin() || isOwner(eventId) || hasScanSession(eventId);

        // Adding a guest — manually, via CSV import, or by approving a
        // self-registration request — is the action gated on the free tier
        // (first 5) / payment.
        allow create: if request.auth != null &&
          (isAdmin() || eventCanAcceptGuest(eventId, request.auth.uid));

        // Editing/removing existing guests (attendance, deletes) is not
        // part of the payment gate.
        allow update, delete: if isAdmin() || isOwner(eventId);

        // The door-scanner check-in flip: only from a device holding a valid
        // session, and only ever false -> true on exactly these two fields.
        // This used to be allowed with no login and no code check at all —
        // anyone holding an invite link could mark any guest as already
        // checked in.
        allow update: if hasScanSession(eventId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scanned', 'scannedAt']) &&
          resource.data.scanned == false &&
          request.resource.data.scanned == true;
      }

      match /requests/{requestId} {
        // Guest RSVP submissions — public and unauthenticated by design, so
        // this is the one place a stranger can write without being the
        // event owner. Field-shape validation is the only spam guard
        // available on the free plan (no Cloud Functions for real rate
        // limiting), but it blocks arbitrary extra fields and outsized junk.
        //
        // The document is named after the request's own id (reqId), which
        // the guest's browser generates as 128 random bits and keeps as its
        // only key to the request. The length check is what stops a guest
        // from naming theirs something guessable.
        allow create: if request.resource.data.keys().hasOnly(['name', 'reqId', 'status', 'createdAt']) &&
          request.resource.data.reqId == requestId &&
          requestId.size() >= 20 &&
          request.resource.data.status == 'pending' &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100;

        // Opening ONE request by its exact id is open to anyone (that's how a
        // guest sees their own status and, once approved, their card) —
        // useless without knowing the id. Listing them is not: it used to be
        // open to anyone with the invite link, which exposed every guest's
        // name, and (after approval) their barcode id, to a stranger.
        allow get: if true;
        allow list: if isAdmin() || isOwner(eventId);

        allow update, delete: if isAdmin() || isOwner(eventId);
      }
    }
  }
}
